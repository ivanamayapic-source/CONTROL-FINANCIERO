# -----------------------------------------------------------------------------
# VARIABLES DE ENTORNO (Plantilla)
# Nunca subas el archivo .env real a Git. Copia este archivo como .env
# -----------------------------------------------------------------------------

# SUPABASE POSTGRESQL (Entorno DEV)
# DATABASE_URL: Usa el puerto de Connection Pooling (generalmente 6543) y añade ?pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://postgres.[PROYECTO_ID]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# DIRECT_URL: Usa el puerto directo (5432) para ejecutar migraciones de Prisma
DIRECT_URL="postgresql://postgres.[PROYECTO_ID]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# NEXTAUTH
# NEXTAUTH_URL: URL base de tu aplicación (localhost:3000 para dev)
NEXTAUTH_URL="http://localhost:3000"

# NEXTAUTH_SECRET: Genera uno seguro corriendo en la terminal: `openssl rand -base64 32`
NEXTAUTH_SECRET="tu_secreto_generado_aqui"
