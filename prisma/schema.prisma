generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String    @unique
  passwordHash  String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts             Account[]
  categories           Category[]
  transactions         Transaction[]
  budgets              Budget[]
  debts                Debt[]
  savingGoals          SavingGoal[]
  recurringPayments    RecurringPayment[]
}

model Account {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  type      String   // e.g., 'banco', 'ahorro', 'efectivo', 'tarjeta_credito'
  balance   Decimal  @db.Decimal(19, 4) @default(0)
  currency  String   @default("COP")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactionsFrom Transaction[] @relation("FromAccount")
  transactionsTo   Transaction[] @relation("ToAccount")
  recurringPayments RecurringPayment[]
}

model Category {
  id        String   @id @default(uuid())
  userId    String?  // Null means it's a global default category
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  type      String   // 'ingreso' or 'gasto'
  icon      String?
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions      Transaction[]
  budgets           Budget[]
  recurringPayments RecurringPayment[]
}

model Transaction {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // For Income/Expense this is the account. For Transfers this is the Source Account
  accountId     String
  account       Account   @relation("FromAccount", fields: [accountId], references: [id])
  
  // Destination account is only for Transfers
  toAccountId   String?
  toAccount     Account?  @relation("ToAccount", fields: [toAccountId], references: [id])

  categoryId    String?
  category      Category? @relation(fields: [categoryId], references: [id])
  
  amount        Decimal   @db.Decimal(19, 4)
  date          DateTime
  type          String    // 'ingreso', 'gasto', 'transferencia'
  concept       String
  notes         String?
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime? // Soft delete

  debtPayments       DebtPayment[]
  goalContributions  GoalContribution[]
}

model Budget {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  amount      Decimal  @db.Decimal(19, 4)
  month       Int
  year        Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Debt {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  entity          String?
  initialAmount   Decimal  @db.Decimal(19, 4)
  currentBalance  Decimal  @db.Decimal(19, 4)
  monthlyFee      Decimal  @db.Decimal(19, 4)
  dueDate         DateTime?
  interestRate    Decimal? @db.Decimal(5, 2)
  installments    Int?
  status          String   @default("activa") // 'activa', 'pagada'
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  payments        DebtPayment[]
}

model DebtPayment {
  id              String       @id @default(uuid())
  debtId          String
  debt            Debt         @relation(fields: [debtId], references: [id], onDelete: Cascade)
  transactionId   String?
  transaction     Transaction? @relation(fields: [transactionId], references: [id])
  amount          Decimal      @db.Decimal(19, 4)
  date            DateTime
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deletedAt       DateTime?    // Soft delete
}

model SavingGoal {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  targetAmount  Decimal  @db.Decimal(19, 4)
  currentAmount Decimal  @db.Decimal(19, 4) @default(0)
  targetDate    DateTime?
  description   String?
  status        String   @default("activa") // 'activa', 'completada'
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  contributions GoalContribution[]
}

model GoalContribution {
  id              String       @id @default(uuid())
  goalId          String
  goal            SavingGoal   @relation(fields: [goalId], references: [id], onDelete: Cascade)
  transactionId   String?
  transaction     Transaction? @relation(fields: [transactionId], references: [id])
  amount          Decimal      @db.Decimal(19, 4)
  date            DateTime
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deletedAt       DateTime?    // Soft delete
}

model RecurringPayment {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  amount      Decimal  @db.Decimal(19, 4)
  frequency   String   // 'mensual', 'semanal', etc.
  nextDate    DateTime
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  accountId   String?
  account     Account?  @relation(fields: [accountId], references: [id])
  status      String   @default("activo") // 'activo', 'pausado'
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
